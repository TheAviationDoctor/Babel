.DS_Store
# Of the books, only what the catalogue reads is published, the list and the shelf, and
# the script that writes them, books/shelve.js (see "Your books" in README.md).
books/*
!books/shelve.js
!books/index.js
!books/compressed/
books/compressed/*.partial
# Of the paintings likewise: the list and the paintings as the catalogue reads them, and the
# script that writes them, paintings/hang.js; not the pictures (see "Your paintings").
paintings/*
!paintings/hang.js
!paintings/index.js
!paintings/compressed/
# Notes kept out of the repository
PERFORMANCE_REVIEW.md
# The tools the tests run on (npm install puts them back)
node_modules/
